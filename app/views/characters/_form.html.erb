<div class="max-w-4xl mx-auto p-6"
     data-controller="stat-generator"
     data-stat-generator-class-data-value="<%= @class_options.to_json %>"
     data-stat-generator-species-data-value="<%= @species_options.to_json %>"
     data-stat-generator-saved-subclass-value="<%= character.subclass_id %>"
     data-stat-generator-saved-skills-value="<%= (character.skill_proficiencies || []).to_json %>">

  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-slate-800">
      <%= character.persisted? ? "Edit Character" : "Create New Character" %>
    </h1>
    <%= link_to "Cancel", character.persisted? ? character_path(character) : characters_path, class: "text-slate-500 hover:text-slate-800 text-sm font-semibold" %>
  </div>

  <%= form_with(model: character, local: true) do |f| %>
    <!-- Basic Info Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-6">
      <div>
        <%= f.label :name, class: "block font-medium mb-1 text-slate-700" %>
        <%= f.text_field :name, required: true, class: "w-full border rounded p-2 focus:ring-2 focus:ring-indigo-500 outline-none" %>
      </div>

      <div>
        <%= f.label :level, class: "block font-medium mb-1 text-slate-700" %>
        <%= f.select :level, (1..20).to_a, {},
                     { class: "w-full border rounded p-2 focus:ring-2 focus:ring-indigo-500 outline-none",
                       data: { stat_generator_target: "levelSelect", action: "change->stat-generator#recalculateAll" } } %>
      </div>

      <div>
        <%= f.label :species_id, "Species", class: "block font-medium mb-1 text-slate-700" %>
        <%= f.collection_select :species_id, @species_options, :id, :name, {},
                                { class: "w-full border rounded p-2 focus:ring-2 focus:ring-indigo-500 outline-none",
                                  data: { stat_generator_target: "speciesSelect", action: "change->stat-generator#recalculateAll" } } %>
      </div>

      <div>
        <%= f.label :character_class_id, "Class", class: "block font-medium mb-1 text-slate-700" %>
        <%= f.collection_select :character_class_id, @class_options, :id, :name, {},
                                { class: "w-full border rounded p-2 focus:ring-2 focus:ring-indigo-500 outline-none",
                                  data: { stat_generator_target: "classSelect", action: "change->stat-generator#recalculateAll" } } %>
      </div>
    </div>

    <!-- Dynamic Subclass Block -->
    <div data-stat-generator-target="subclassContainer" class="<%= 'hidden' unless character.level >= 3 %> mb-6 p-4 bg-indigo-50 border border-indigo-200 rounded-lg">
      <div class="flex justify-between items-center mb-1">
        <label class="block font-bold text-sm text-indigo-950">Select Subclass / Archetype</label>
        <span class="text-[10px] font-semibold uppercase text-indigo-600 bg-indigo-100 px-2 py-0.5 rounded">2024 Rule: Level 3 Unlocked</span>
      </div>
      <select name="character[subclass_id]"
              data-stat-generator-target="subclassSelect"
              data-action="change->stat-generator#recalculateAll"
              class="w-full border rounded p-2 text-sm bg-white focus:ring-2 focus:ring-indigo-500">
      </select>
    </div>

    <!-- Live Health Preview Banner -->
    <div class="bg-slate-900 text-white p-4 rounded-lg mb-6 flex justify-between items-center shadow">
      <div>
        <span class="text-xs uppercase tracking-wider text-slate-400 block font-semibold">Max Health</span>
        <span class="text-xs text-slate-300">Scales automatically by Level & Constitution</span>
      </div>
      <div class="text-3xl font-extrabold text-green-400" data-stat-generator-target="maxHp">--</div>
    </div>

    <!-- Starting Equipment Block -->
    <div style="margin-bottom: 2rem;">
      <h3 style="margin-bottom: 0.5rem; color: #0f172a;">Starting Equipment</h3>

      <% current_class = @character.character_class || @character_class %>

      <% if current_class&.starting_equipment.present? %>
        <p style="color: #64748b; margin-top: 0; font-size: 0.95rem;">Select one loadout package for your class:</p>

        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <% current_class.starting_equipment.each do |key, items| %>
            <label style="display: flex; align-items: flex-start; gap: 0.75rem; background: #f8fafc; border: 1px solid #cbd5e1; padding: 1rem; border-radius: 8px; cursor: pointer; transition: border-color 0.2s;">
              <%= f.radio_button :equipment_loadout, key, style: "margin-top: 0.25rem;" %>
              <div>
                <strong style="color: #1e293b; display: block; margin-bottom: 0.25rem;">Option <%= key %></strong>
                <span style="color: #475569; font-size: 0.9rem; line-height: 1.4;">
                  <%= items.is_a?(Array) ? items.join(", ") : items %>
                </span>
              </div>
            </label>
          <% end %>
        </div>
      <% else %>
        <p style="color: #64748b; font-style: italic;">Select a class above to see available starting loadouts.</p>
      <% end %>
    </div>

    <!-- Skill Proficiencies Block -->
    <div class="border rounded-lg p-5 mb-6 bg-slate-50/50 shadow-sm">
      <h2 class="text-xl font-bold text-slate-800 mb-1">Skill Proficiencies</h2>
      <p class="text-xs text-slate-500 mb-3" data-stat-generator-target="skillCountNotice">Select skills:</p>
      <div data-stat-generator-target="skillContainer"></div>
    </div>

    <!-- Live Unlocked Features Preview -->
    <div class="border rounded-lg p-5 mb-6 bg-slate-50/50 shadow-sm">
      <h2 class="text-xl font-bold text-slate-800 mb-2">Unlocked Features Preview</h2>
      <div data-stat-generator-target="featuresContainer"></div>
    </div>

    <!-- Ability Score Generation Section -->
    <div class="border rounded-lg p-5 mb-6 bg-slate-50/50 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4 pb-4 border-b">
        <h2 class="text-xl font-bold text-slate-800">Ability Score Generation</h2>

        <div class="flex items-center gap-2">
          <label class="font-semibold text-sm text-slate-600">Method:</label>
          <select data-stat-generator-target="mode" data-action="change->stat-generator#updateMode" class="border rounded p-1.5 text-sm bg-white font-medium focus:ring-2 focus:ring-indigo-500">
            <% if character.persisted? %>
              <option value="custom" selected>Saved Stats (Custom)</option>
            <% end %>
            <option value="array">Standard Array (15, 14, 13, 12, 10, 8)</option>
            <option value="point_buy">Point Buy (27 Points)</option>
            <option value="dice">Roll Dice</option>
          </select>
        </div>
      </div>

      <!-- Point Buy Budget Banner -->
      <div data-stat-generator-target="pointBuyContainer" class="hidden mb-4 p-3 bg-indigo-50 border border-indigo-200 rounded-lg text-center">
        <p class="font-bold text-indigo-950">
          Points Remaining: <span data-stat-generator-target="pointBudget" class="text-2xl text-indigo-600 font-extrabold mx-1">27</span> / 27
        </p>
      </div>

      <!-- Dice Rolling Controls -->
      <div data-stat-generator-target="diceContainer" class="hidden mb-6 p-4 bg-white border rounded-lg shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b pb-3">
          <div class="flex items-center gap-2">
            <label class="font-semibold text-sm text-slate-700">Formula:</label>
            <select data-stat-generator-target="diceRule" class="border rounded p-1 text-sm bg-slate-50">
              <option value="4d6_drop_1">4d6, drop lowest</option>
              <option value="5d6_drop_2">5d6, drop 2 lowest</option>
            </select>
          </div>
          <button type="button" data-action="click->stat-generator#rollAllDice" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm px-4 py-2 rounded-md transition shadow-sm">
            🎲 Roll Stats
          </button>
        </div>

        <div data-stat-generator-target="diceResults">
          <p class="text-xs text-slate-400 italic text-center py-4">Click "Roll Stats" to generate 6 scores.</p>
        </div>
      </div>

      <!-- Ability Score Cards -->
      <div class="grid grid-cols-2 md:grid-cols-6 gap-3">
        <% [
             [:strength, "str"],
             [:dexterity, "dex"],
             [:constitution, "con"],
             [:intelligence, "int"],
             [:wisdom, "wis"],
             [:charisma, "cha"]
           ].each do |stat, short_stat| %>
          <div class="border p-3 rounded-lg bg-white text-center shadow-sm flex flex-col justify-between">
            <label class="block font-bold uppercase text-xs tracking-wider text-slate-500 mb-2"><%= stat %></label>

            <%= f.number_field stat,
                               class: "w-full text-center font-extrabold text-xl border rounded p-1 mb-2 bg-slate-50",
                               data: { stat_generator_target: short_stat, action: "input->stat-generator#recalculateAll" } %>

            <select data-stat-generator-target="diceSelect"
                    data-stat="<%= short_stat %>"
                    data-action="change->stat-generator#assignDiceScore"
                    class="hidden w-full text-center font-bold border rounded p-1 mb-2 bg-indigo-50 text-indigo-900 border-indigo-200">
              <option value="">-- Select --</option>
            </select>

            <div data-stat-generator-target="pointBuyButtons" class="hidden flex justify-center gap-1 mb-2">
              <button type="button" data-action="click->stat-generator#adjustPointBuy" data-stat="<%= short_stat %>" data-delta="-1" class="w-8 h-8 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded flex items-center justify-center border">-</button>
              <button type="button" data-action="click->stat-generator#adjustPointBuy" data-stat="<%= short_stat %>" data-delta="1" class="w-8 h-8 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded flex items-center justify-center border">+</button>
            </div>

            <div class="text-xs text-slate-500 font-medium pt-2 border-t">
              Mod: <span data-stat-generator-target="<%= short_stat %>Mod" class="font-bold text-slate-800">+0 (10)</span>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <%= f.submit character.persisted? ? "Save Changes" : "Create Character", class: "w-full sm:w-auto bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-8 rounded-lg cursor-pointer transition shadow" %>
  <% end %>
</div>