<div data-controller="wizard">
  <!-- D&D Beyond Style Stepper Navigation -->
  <nav class="flex border-b border-slate-200 mb-8 overflow-x-auto bg-slate-900 text-white rounded-t-lg shadow-sm">
    <button type="button" data-wizard-target="tab" data-step-index="0" data-action="click->wizard#goToTab" class="px-6 py-4 flex items-center gap-2 text-sm tracking-wide transition border-b-4 border-red-600 font-bold">
      <span class="w-6 h-6 rounded-full bg-red-600 text-white text-xs flex items-center justify-center font-bold">1</span>
      ABILITIES
    </button>

    <button type="button" data-wizard-target="tab" data-step-index="1" data-action="click->wizard#goToTab" class="px-6 py-4 flex items-center gap-2 text-sm tracking-wide text-slate-400 transition border-b-4 border-transparent">
      <span class="w-6 h-6 rounded-full bg-slate-700 text-slate-300 text-xs flex items-center justify-center font-bold">2</span>
      CLASS
    </button>

    <button type="button" data-wizard-target="tab" data-step-index="2" data-action="click->wizard#goToTab" class="px-6 py-4 flex items-center gap-2 text-sm tracking-wide text-slate-400 transition border-b-4 border-transparent">
      <span class="w-6 h-6 rounded-full bg-slate-700 text-slate-300 text-xs flex items-center justify-center font-bold">3</span>
      SPECIES
    </button>

    <button type="button" data-wizard-target="tab" data-step-index="3" data-action="click->wizard#goToTab" class="px-6 py-4 flex items-center gap-2 text-sm tracking-wide text-slate-400 transition border-b-4 border-transparent">
      <span class="w-6 h-6 rounded-full bg-slate-700 text-slate-300 text-xs flex items-center justify-center font-bold">4</span>
      BACKGROUND
    </button>

    <button type="button" data-wizard-target="tab" data-step-index="4" data-action="click->wizard#goToTab" class="px-6 py-4 flex items-center gap-2 text-sm tracking-wide text-slate-400 transition border-b-4 border-transparent">
      <span class="w-6 h-6 rounded-full bg-slate-700 text-slate-300 text-xs flex items-center justify-center font-bold">5</span>
      EQUIPMENT & REVIEW
    </button>
  </nav>

  <%= form_with(model: character, local: true) do |f| %>

    <!-- STEP 1: ABILITIES -->
    <div data-wizard-target="step" data-controller="stat-generator">
      <input type="hidden"
             name="character[generation_method]"
             data-stat-generator-target="methodInput"
             value="<%= character.generation_method || 'standard_array' %>">
      <!-- Generation Method Tabs -->
      <div class="flex flex-wrap gap-2 mb-8 bg-slate-900 p-2 rounded-lg">
        <button type="button"
                data-stat-generator-target="methodTab"
                data-method="standard_array"
                data-action="click->stat-generator#changeMethod"
                class="px-4 py-2 text-xs font-bold rounded tracking-wider uppercase transition bg-red-700 text-white">
          Standard Array
        </button>
        <button type="button"
                data-stat-generator-target="methodTab"
                data-method="point_buy"
                data-action="click->stat-generator#changeMethod"
                class="px-4 py-2 text-xs font-bold rounded tracking-wider uppercase transition bg-slate-800 text-slate-300 hover:text-white">
          Point Buy
        </button>
        <button type="button"
                data-stat-generator-target="methodTab"
                data-method="roll"
                data-action="click->stat-generator#changeMethod"
                class="px-4 py-2 text-xs font-bold rounded tracking-wider uppercase transition bg-slate-800 text-slate-300 hover:text-white">
          Roll 4d6
        </button>
        <button type="button"
                data-stat-generator-target="methodTab"
                data-method="manual"
                data-action="click->stat-generator#changeMethod"
                class="px-4 py-2 text-xs font-bold rounded tracking-wider uppercase transition bg-slate-800 text-slate-300 hover:text-white">
          Manual Entry
        </button>
      </div>

      <!-- POINT BUY INTERFACE -->
      <div data-stat-generator-target="pointBuySection" style="display: none;" class="mb-8 p-4 bg-slate-50 rounded-lg border border-slate-200">
        <div class="flex justify-between items-center mb-4 pb-2 border-b border-slate-200">
          <span class="font-bold text-slate-800">Point Buy Budget</span>
          <span class="text-lg font-bold text-red-600">
            Points Remaining: <span data-stat-generator-target="pointsRemaining">27</span> / 27
          </span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% %w[strength dexterity constitution intelligence wisdom charisma].each do |stat| %>
            <div class="flex items-center justify-between p-3 bg-white rounded border border-slate-200 shadow-sm">
              <span class="font-semibold capitalize text-slate-700"><%= stat %></span>
              <div class="flex items-center gap-3">
                <button type="button"
                        data-stat="<%= stat %>"
                        data-delta="-1"
                        data-action="click->stat-generator#adjustPointBuy"
                        class="w-8 h-8 rounded bg-slate-200 hover:bg-slate-300 font-bold text-slate-700 flex items-center justify-center">-</button>
                <button type="button"
                        data-stat="<%= stat %>"
                        data-delta="1"
                        data-action="click->stat-generator#adjustPointBuy"
                        class="w-8 h-8 rounded bg-red-600 hover:bg-red-700 font-bold text-white flex items-center justify-center">+</button>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- STANDARD ARRAY INTERFACE -->
      <div data-stat-generator-target="arraySection" class="mb-8 p-4 bg-slate-50 rounded-lg border border-slate-200">
        <p class="text-xs text-slate-500 mb-4 font-semibold uppercase tracking-wider">Assign scores from [15, 14, 13, 12, 10, 8]</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% %w[strength dexterity constitution intelligence wisdom charisma].each do |stat| %>
            <div class="flex items-center justify-between p-3 bg-white rounded border border-slate-200 shadow-sm">
              <label class="font-semibold capitalize text-slate-700"><%= stat %></label>
              <select data-stat-generator-target="arraySelect"
                      data-stat="<%= stat %>"
                      data-action="change->stat-generator#updateArrayAssignment"
                      class="border border-slate-300 rounded px-3 py-1 bg-white font-medium text-slate-800">
                <option value="">Select</option>
                <option value="15">15</option>
                <option value="14">14</option>
                <option value="13">13</option>
                <option value="12">12</option>
                <option value="10">10</option>
                <option value="8">8</option>
              </select>
            </div>
          <% end %>
        </div>
      </div>

      <!-- ROLL 4d6 INTERFACE -->
      <div data-stat-generator-target="rollSection" style="display: none;" class="mb-8 p-4 bg-slate-50 rounded-lg border border-slate-200">
        <div class="text-center mb-6">
          <button type="button"
                  data-action="click->stat-generator#rollDice"
                  class="px-6 py-3 bg-red-700 hover:bg-red-800 text-white font-bold rounded shadow transition mb-2">
            🎲 Roll Ability Scores (4d6 Drop Lowest)
          </button>
          <p data-stat-generator-target="rolledPool" class="font-mono text-base font-bold text-slate-700">
            Click the button above to generate 6 scores!
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 border-t border-slate-200 pt-4">
          <% %w[strength dexterity constitution intelligence wisdom charisma].each do |stat| %>
            <div class="flex items-center justify-between p-3 bg-white rounded border border-slate-200 shadow-sm">
              <label class="font-semibold capitalize text-slate-700"><%= stat %></label>
              <select data-stat-generator-target="rollSelect"
                      data-stat="<%= stat %>"
                      data-action="change->stat-generator#updateRollAssignment"
                      disabled
                      class="border border-slate-300 rounded px-3 py-1 bg-white font-medium text-slate-800 disabled:bg-slate-100 disabled:text-slate-400">
                <option value="">Roll First</option>
              </select>
            </div>
          <% end %>
        </div>
      </div>

      <!-- MANUAL SECTION NOTE -->
      <div data-stat-generator-target="manualSection" style="display: none;" class="mb-8 p-4 bg-slate-50 rounded-lg border border-slate-200">
        <p class="text-sm text-slate-600">Type custom score values directly into the input fields below (range 3–18).</p>
      </div>

      <!-- BASE STAT INPUTS -->
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6 pt-4 border-t border-slate-200">
        <div>
          <%= f.label :strength, "STR", class: "block font-bold text-xs text-slate-500 uppercase tracking-wider mb-1" %>
          <%= f.number_field :strength, class: "w-full border rounded p-2 text-center font-bold text-lg", "data-stat-generator-target": "strInput" %>
        </div>
        <div>
          <%= f.label :dexterity, "DEX", class: "block font-bold text-xs text-slate-500 uppercase tracking-wider mb-1" %>
          <%= f.number_field :dexterity, class: "w-full border rounded p-2 text-center font-bold text-lg", "data-stat-generator-target": "dexInput" %>
        </div>
        <div>
          <%= f.label :constitution, "CON", class: "block font-bold text-xs text-slate-500 uppercase tracking-wider mb-1" %>
          <%= f.number_field :constitution, class: "w-full border rounded p-2 text-center font-bold text-lg", "data-stat-generator-target": "conInput" %>
        </div>
        <div>
          <%= f.label :intelligence, "INT", class: "block font-bold text-xs text-slate-500 uppercase tracking-wider mb-1" %>
          <%= f.number_field :intelligence, class: "w-full border rounded p-2 text-center font-bold text-lg", "data-stat-generator-target": "intInput" %>
        </div>
        <div>
          <%= f.label :wisdom, "WIS", class: "block font-bold text-xs text-slate-500 uppercase tracking-wider mb-1" %>
          <%= f.number_field :wisdom, class: "w-full border rounded p-2 text-center font-bold text-lg", "data-stat-generator-target": "wisInput" %>
        </div>
        <div>
          <%= f.label :charisma, "CHA", class: "block font-bold text-xs text-slate-500 uppercase tracking-wider mb-1" %>
          <%= f.number_field :charisma, class: "w-full border rounded p-2 text-center font-bold text-lg", "data-stat-generator-target": "chaInput" %>
        </div>
      </div>

      <div class="flex justify-end mt-8">
        <button type="button" data-action="click->wizard#next" class="px-6 py-2 bg-red-600 text-white font-semibold rounded hover:bg-red-700">Next: Choose Class &rarr;</button>
      </div>
    </div>

    <!-- STEP 2: CLASS & SUBCLASS -->
    <div data-wizard-target="step"
         style="display: none;"
         data-controller="class-selection"
         data-class-selection-classes-value="<%= CharacterClass.all.map { |c| {
           id: c.id,
           name: c.name,
           skill_choice_count: (c.try(:skill_choice_count) || 2),
           skill_options: (c.try(:skill_options) || []),
           features: (c.try(:features) || {}),
           subclasses: (c.try(:subclasses) || [])
         } }.to_json %>"
         data-class-selection-saved-skills-value="<%= Array(character.skill_proficiencies).to_json %>">
      <h2 class="text-2xl font-bold mb-2 text-slate-900">Step 2: Class & Subclass</h2>
      <p class="text-slate-600 mb-6 text-sm">Select your character's class, level, skill proficiencies, and subclass options.</p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <!-- Level Selector -->
        <div>
          <%= f.label :level, "Character Level", class: "block font-semibold text-slate-700 mb-1" %>
          <%= f.number_field :level,
                             value: character.level || 1,
                             min: 1, max: 20,
                             class: "w-full border border-slate-300 rounded p-2.5 font-bold text-lg text-slate-800 bg-white shadow-sm focus:ring-2 focus:ring-red-600 focus:outline-none",
                             "data-class-selection-target": "levelInput",
                             "data-action": "input->class-selection#updateAll change->class-selection#updateAll" %>
        </div>

        <!-- Class Selector -->
        <div class="md:col-span-2">
          <%= f.label :character_class_id, "Class", class: "block font-semibold text-slate-700 mb-1" %>
          <%= f.select :character_class_id,
                       CharacterClass.all.map { |c| [c.name, c.id] },
                       { prompt: "Select a Class" },
                       class: "w-full border border-slate-300 rounded p-2.5 font-medium text-slate-800 bg-white shadow-sm focus:ring-2 focus:ring-red-600 focus:outline-none",
                       "data-class-selection-target": "classSelect",
                       "data-action": "change->class-selection#updateAll" %>
        </div>
      </div>

      <!-- Class Skill Proficiencies Selector -->
      <div data-class-selection-target="skillsContainer" style="display: none;" class="mb-6 p-4 bg-slate-50 rounded-lg border border-slate-200 shadow-sm">
        <strong data-class-selection-target="skillsHeading" class="block font-bold text-slate-900 text-sm mb-3"></strong>
        <div data-class-selection-target="skillsList" class="grid grid-cols-2 md:grid-cols-3 gap-3"></div>
      </div>

      <!-- Subclass Selector (Unlocked at Level 3+) -->
      <div data-class-selection-target="subclassContainer" style="display: none;" class="mb-6 p-4 bg-amber-50 rounded-lg border border-amber-200">
        <%= f.label :subclass_id, "Subclass (Unlocked at Level 3)", class: "block font-bold text-amber-950 mb-1" %>
        <select name="character[subclass_id]"
                data-class-selection-target="subclassSelect"
                data-selected-subclass="<%= f.object.subclass_id %>"
                data-action="change->class-selection#renderUnlockedSubclassFeatures"
                class="w-full border border-amber-300 rounded p-2.5 font-medium text-slate-800 bg-white shadow-sm focus:ring-2 focus:ring-red-600 focus:outline-none mb-4">
          <option value="">Select a Subclass</option>
        </select>

        <!-- Subclass Features List -->
        <div data-class-selection-target="subclassFeaturesContainer" style="display: none;">
          <h4 class="font-bold text-xs uppercase tracking-wider text-amber-900 mb-2">Unlocked Subclass Features</h4>
          <div data-class-selection-target="subclassFeaturesList" class="space-y-2"></div>
        </div>
      </div>

      <!-- Unlocked Class Features Readout -->
      <div data-class-selection-target="unlockedFeaturesContainer" style="display: none;" class="mb-8 p-5 bg-slate-50 rounded-lg border border-slate-200 shadow-sm">
        <h3 class="font-bold text-slate-900 text-sm uppercase tracking-wider mb-3">
          Unlocked Class Features (<span data-class-selection-target="levelDisplay">Level 1</span>)
        </h3>
        <div data-class-selection-target="featuresList" class="space-y-2.5"></div>
      </div>

      <!-- Step Controls -->
      <div class="flex justify-between mt-8">
        <button type="button" data-action="click->wizard#previous" class="px-6 py-2.5 bg-slate-200 hover:bg-slate-300 text-slate-800 font-semibold rounded transition">
          &larr; Back
        </button>
        <button type="button" data-action="click->wizard#next" class="px-6 py-2.5 bg-red-600 hover:bg-red-700 text-white font-semibold rounded shadow transition">
          Next: Choose Species &rarr;
        </button>
      </div>
    </div>
    <!-- STEP 3: SPECIES -->
    <div data-wizard-target="step"
         style="display: none;"
         data-controller="species-selection"
         data-species-selection-species-value="<%= Species.all.map(&:as_json).to_json %>">

      <h2 class="text-2xl font-bold mb-2 text-slate-900">Step 3: Choose Species</h2>
      <p class="text-slate-600 mb-6 text-sm">Select a species to view its traits, speed, and lineage options.</p>

      <div class="mb-6">
        <%= f.label :species_id, "Species", class: "block font-semibold text-slate-700 mb-1" %>
        <%= f.select :species_id,
                     Species.all.map { |s| [s.name, s.id] },
                     { prompt: "Select a Species" },
                     class: "w-full border border-slate-300 rounded p-2.5 font-medium text-slate-800 bg-white shadow-sm focus:ring-2 focus:ring-red-600 focus:outline-none",
                     "data-species-selection-target": "speciesSelect",
                     "data-action": "change->species-selection#updateDetails" %>
      </div>

      <div data-species-selection-target="sizeChoiceContainer" style="display: none;" class="mb-6 p-4 bg-slate-100 rounded-lg border border-slate-200">
        <label class="block font-bold text-slate-900 mb-1">Character Size</label>
        <select name="character[size]"
                data-species-selection-target="sizeSelect"
                class="w-full border border-slate-300 rounded p-2.5 font-medium text-slate-800 bg-white shadow-sm focus:ring-2 focus:ring-red-600 focus:outline-none">
        </select>
      </div>

      <div data-species-selection-target="lineageContainer" style="display: none;" class="mb-6 p-4 bg-slate-100 rounded-lg border border-slate-200">
        <label class="block font-bold text-slate-900 mb-1">Elven Lineage</label>
        <select name="character[species_lineage]"
                data-species-selection-target="lineageSelect"
                data-action="change->species-selection#updateLineage"
                class="w-full border border-slate-300 rounded p-2.5 font-medium text-slate-800 bg-white shadow-sm focus:ring-2 focus:ring-red-600 focus:outline-none mb-3">
          <option value="">Select a Lineage</option>
        </select>
        <div data-species-selection-target="lineageDetails"></div>
      </div>

      <div data-species-selection-target="spellcastingAbilityContainer" style="display: none;" class="mb-6 p-4 bg-slate-100 rounded-lg border border-slate-200">
        <label class="block font-bold text-slate-900 mb-1">Lineage Spellcasting Ability</label>
        <select name="character[lineage_spellcasting_ability]" class="w-full border border-slate-300 rounded p-2.5 font-medium text-slate-800 bg-white shadow-sm focus:ring-2 focus:ring-red-600 focus:outline-none">
          <option value="intelligence">Intelligence</option>
          <option value="wisdom">Wisdom</option>
          <option value="charisma">Charisma</option>
        </select>
      </div>

      <div data-species-selection-target="detailsContainer" style="display: none;" class="mb-8 p-6 bg-slate-50 rounded-lg border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between border-b border-slate-200 pb-3 mb-4">
          <h3 data-species-selection-target="name" class="text-xl font-bold text-slate-900"></h3>

          <div class="flex gap-2 text-xs font-semibold uppercase tracking-wider text-slate-600">
            <span class="px-3 py-1 bg-slate-200 rounded">Size: <strong data-species-selection-target="size" class="text-slate-900"></strong></span>
            <span class="px-3 py-1 bg-slate-200 rounded">Speed: <strong data-species-selection-target="speed" class="text-slate-900"></strong></span>
          </div>
        </div>

        <p data-species-selection-target="description" class="text-slate-600 text-sm mb-6 leading-relaxed italic"></p>

        <div class="pt-4 border-t border-slate-200">
          <h4 class="font-bold text-xs uppercase tracking-wider text-slate-500 mb-3">Racial Traits</h4>
          <div data-species-selection-target="traits" class="space-y-2"></div>
        </div>
      </div>

      <div class="flex justify-between mt-8">
        <button type="button" data-action="click->wizard#previous" class="px-6 py-2.5 bg-slate-200 hover:bg-slate-300 text-slate-800 font-semibold rounded transition">
          &larr; Back
        </button>
        <button type="button" data-action="click->wizard#next" class="px-6 py-2.5 bg-red-600 hover:bg-red-700 text-white font-semibold rounded shadow transition">
          Next: Choose Background &rarr;
        </button>
      </div>
    </div>

    <!-- STEP 4: BACKGROUND -->
    <div data-wizard-target="step"
         style="display: none;"
         data-controller="background-selection"
         data-background-selection-backgrounds-value="<%= Background.all.map(&:as_json).to_json %>">

      <h2 class="text-2xl font-bold mb-2 text-slate-900">Step 4: Choose Background</h2>
      <p class="text-slate-600 mb-6 text-sm">Filter backgrounds by ability score choices or choose directly from the list.</p>

      <div class="mb-6 p-4 bg-slate-900 rounded-lg text-white">
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Filter by Ability Scores Given:</label>
        <div class="flex flex-wrap gap-4">
          <% %w[STR DEX CON INT WIS CHA].each do |attr| %>
            <label class="flex items-center gap-2 cursor-pointer text-sm font-semibold">
              <input type="checkbox"
                     value="<%= attr %>"
                     data-background-selection-target="filterAttribute"
                     data-action="change->background-selection#filterBackgrounds"
                     class="w-4 h-4 rounded text-red-600 focus:ring-red-500 accent-red-600">
              <span><%= attr %></span>
            </label>
          <% end %>
        </div>
      </div>

      <div class="mb-6">
        <%= f.label :background_id, "Background", class: "block font-semibold text-slate-700 mb-1" %>
        <select name="character[background_id]"
                data-background-selection-target="backgroundSelect"
                data-action="change->background-selection#updateDetails"
                class="w-full border border-slate-300 rounded p-2.5 font-medium text-slate-800 bg-white shadow-sm focus:ring-2 focus:ring-red-600 focus:outline-none">
          <option value="">Select a Background</option>
        </select>
      </div>

      <div data-background-selection-target="detailsContainer" style="display: none;" class="mb-8 p-6 bg-slate-50 rounded-lg border border-slate-200 shadow-sm">
        <h3 data-background-selection-target="name" class="text-xl font-bold text-slate-900 mb-2 border-b border-slate-200 pb-2"></h3>

        <p data-background-selection-target="description" class="text-slate-600 text-sm mb-6 leading-relaxed italic"></p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
          <div class="p-3 bg-white rounded border border-slate-200">
            <strong class="text-xs uppercase tracking-wider text-slate-500 block mb-1">Origin Feat</strong>
            <span data-background-selection-target="feat" class="text-slate-900 font-bold"></span>
          </div>
          <div class="p-3 bg-white rounded border border-slate-200">
            <strong class="text-xs uppercase tracking-wider text-slate-500 block mb-1">Skill Proficiencies</strong>
            <span data-background-selection-target="skills" class="text-slate-900 font-semibold capitalize"></span>
          </div>
          <div class="p-3 bg-white rounded border border-slate-200">
            <strong class="text-xs uppercase tracking-wider text-slate-500 block mb-1">Tool Proficiency</strong>
            <span data-background-selection-target="tools" class="text-slate-900 font-semibold"></span>
          </div>
          <div class="p-3 bg-white rounded border border-slate-200">
            <strong class="text-xs uppercase tracking-wider text-slate-500 block mb-1">Equipment Package</strong>
            <span data-background-selection-target="equipment" class="text-slate-700 text-xs leading-relaxed"></span>
          </div>
        </div>

        <div class="pt-4 border-t border-slate-200">
          <div class="flex items-center justify-between mb-4">
            <h4 class="font-bold text-sm uppercase tracking-wider text-slate-800">Background Ability Score Boosts</h4>

            <select data-background-selection-target="boostMode"
                    data-action="change->background-selection#changeBoostMode"
                    class="border border-slate-300 rounded px-3 py-1 bg-white font-semibold text-xs text-slate-700">
              <option value="two_one">+2 / +1 Boost (Choose 2)</option>
              <option value="three_ones">+1 / +1 / +1 Boost (Choose 3)</option>
            </select>
          </div>

          <div data-background-selection-target="boostControls" class="p-4 bg-white rounded border border-slate-200"></div>
        </div>
      </div>

      <div class="flex justify-between mt-8">
        <button type="button" data-action="click->wizard#previous" class="px-6 py-2.5 bg-slate-200 hover:bg-slate-300 text-slate-800 font-semibold rounded transition">
          &larr; Back
        </button>
        <button type="button" data-action="click->wizard#next" class="px-6 py-2.5 bg-red-600 hover:bg-red-700 text-white font-semibold rounded shadow transition">
          Next: Equipment & Review &rarr;
        </button>
      </div>
    </div>

    <!-- STEP 5: NAME & EQUIPMENT REVIEW -->
    <div data-wizard-target="step"
         style="display: none;"
         data-controller="equipment"
         data-equipment-classes-value="<%= CharacterClass.all.map { |c| { id: c.id, starting_equipment: c.starting_equipment || {} } }.to_json %>"
         data-equipment-backgrounds-value="<%= Background.all.map(&:as_json).to_json %>"
         data-equipment-items-value="<%= Item.all.map(&:as_json).to_json %>">

      <h2 class="text-2xl font-bold mb-2 text-slate-900">Step 5: Character Details & Equipment</h2>
      <p class="text-slate-600 mb-6 text-sm">Set your character's name and customize your starting gear.</p>

      <div class="mb-8">
        <%= f.label :name, "Character Name", class: "block font-bold text-slate-900 mb-1" %>
        <%= f.text_field :name,
                         class: "w-full border border-slate-300 rounded p-3 text-lg font-semibold text-slate-900 bg-white shadow-sm focus:ring-2 focus:ring-red-600 focus:outline-none",
                         placeholder: "e.g. Valeros, Gimli, Jester" %>
      </div>

      <div class="space-y-6 mb-8">
        <!-- Class Starting Equipment Selection -->
        <div class="p-5 bg-slate-50 rounded-lg border border-slate-200">
          <h3 class="font-bold text-slate-900 text-base mb-1">Class Starting Loadout / Gold</h3>
          <p class="text-xs text-slate-500 mb-4">Choose one package provided by your class or take starting gold:</p>

          <div data-equipment-target="classOptions"></div>
        </div>

        <!-- Background Starting Equipment Selection -->
        <div class="p-5 bg-slate-50 rounded-lg border border-slate-200">
          <h3 class="font-bold text-slate-900 text-base mb-1">Background Equipment / Gold</h3>
          <p class="text-xs text-slate-500 mb-4">Choose whether to take your background gear or 50 GP:</p>

          <div data-equipment-target="backgroundOptions"></div>
        </div>

        <!-- Catalog Item Selection -->
        <div class="p-5 bg-slate-50 rounded-lg border border-slate-200">
          <div class="flex justify-between items-center mb-3">
            <div>
              <h3 class="font-bold text-slate-900 text-base">Additional Items & Possessions</h3>
              <p class="text-xs text-slate-500">Select extra items from the catalog:</p>
            </div>
            <button type="button"
                    data-action="click->equipment#addCustomItem"
                    class="px-3 py-1.5 bg-slate-800 hover:bg-slate-900 text-white font-semibold rounded text-xs transition flex items-center gap-1">
              + Add Item
            </button>
          </div>

          <div data-equipment-target="customItemsContainer" class="space-y-2"></div>
        </div>
      </div>

      <!-- Step Controls & Final Submission -->
      <div class="flex justify-between mt-8 border-t border-slate-200 pt-6">
        <button type="button" data-action="click->wizard#previous" class="px-6 py-2.5 bg-slate-200 hover:bg-slate-300 text-slate-800 font-semibold rounded transition">
          &larr; Back
        </button>
        <%= f.submit "Create Character", class: "px-8 py-3 bg-red-700 hover:bg-red-800 text-white font-bold rounded-lg shadow-md hover:shadow-lg transition cursor-pointer text-lg tracking-wide" %>
      </div>
    </div>
  <% end %>
</div>